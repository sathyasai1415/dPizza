  transform: translate3d(0, 0, 0);
  will-change: transform, opacity;
  user-select: none;
}

.glowing-particle {
  position: absolute;
  border-radius: 50%;
  will-change: transform;
}

.hero-pizza-glow {
  filter: drop-shadow(0 0 35px rgba(220, 38, 38, 0.5)) drop-shadow(0 0 90px rgba(220, 38, 38, 0.25));
}

@keyframes float {
  0% { transform: translateY(0px) rotate(15deg); }
  50% { transform: translateY(-20px) rotate(15deg); }
  100% { transform: translateY(0px) rotate(15deg); }
}

@layer utilities {
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
}

/* ── Glassmorphism / liquid glass ──────────────────────────────────────────── */

.glass {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border: 1px solid rgba(255, 255, 255, 0.12);
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 0.18),
    inset 0 -1px 1px 0 rgba(0, 0, 0, 0.25),
    0 12px 40px -12px rgba(0, 0, 0, 0.5);
}

.glass-soft {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.015));
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
}

/* BorderGlow — red/orange glowing card, matches the old React welcome card */
.border-glow {
  position: relative;
  background: #130608;
  border: 1px solid rgba(220, 38, 38, 0.25);
  box-shadow:
    0 24px 80px -20px rgba(0, 0, 0, 0.7),
    0 0 40px -6px rgba(220, 38, 38, 0.35);
}
.border-glow::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg, #dc2626, #f97316, #fbbf24, #dc2626);
  background-size: 300% 300%;
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0.55;
  animation: border-glow-move 6s ease infinite;
  pointer-events: none;
}
@keyframes border-glow-move {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

/* Liquid glass — animated specular sheen + deep blur, for hero surfaces */
.liquid-glass {
  position: relative;
  isolation: isolate;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02) 40%, rgba(220, 38, 38, 0.04));
  backdrop-filter: blur(26px) saturate(180%);
  -webkit-backdrop-filter: blur(26px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.14);
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 0.25),
    inset 0 -2px 6px 0 rgba(0, 0, 0, 0.3),
    0 24px 70px -20px rgba(0, 0, 0, 0.65);
  overflow: hidden;
}

.liquid-glass::before {
  content: "";
  position: absolute;
  inset: -50%;
  z-index: -1;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(255, 255, 255, 0.07) 60deg,
    transparent 140deg,
    rgba(255, 120, 40, 0.06) 220deg,
    transparent 300deg
  );
  animation: liquid-rotate 14s linear infinite;
  pointer-events: none;
}

.liquid-glass::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: radial-gradient(120% 80% at 20% 0%, rgba(255, 255, 255, 0.12), transparent 55%);
  pointer-events: none;
}

@keyframes liquid-rotate {
  to { transform: rotate(360deg); }
}

@media (prefers-reduced-motion: reduce) {
  .liquid-glass::before { animation: none; }
}

/* Blue liquid-morphism — for the auth / login surface */
.liquid-glass-blue {
  position: relative;
  isolation: isolate;
  background: linear-gradient(135deg, rgba(96, 165, 250, 0.14), rgba(255, 255, 255, 0.03) 42%, rgba(59, 130, 246, 0.08));
  backdrop-filter: blur(30px) saturate(190%);
  -webkit-backdrop-filter: blur(30px) saturate(190%);
  border: 1px solid rgba(147, 197, 253, 0.22);
  box-shadow:
    inset 0 1px 0 0 rgba(255, 255, 255, 0.28),
    inset 0 -2px 8px 0 rgba(0, 0, 0, 0.3),
    0 28px 80px -22px rgba(8, 30, 80, 0.7);
  overflow: hidden;
}

.liquid-glass-blue::before {
  content: "";
  position: absolute;
  inset: -50%;
  z-index: -1;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    rgba(96, 165, 250, 0.10) 70deg,
    transparent 150deg,
    rgba(59, 130, 246, 0.09) 250deg,
    transparent 330deg
  );
  animation: liquid-rotate 16s linear infinite;
  pointer-events: none;
}

.liquid-glass-blue::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: radial-gradient(130% 90% at 25% 0%, rgba(191, 219, 254, 0.16), transparent 55%);
  pointer-events: none;
}

/* Morphing blobs for the liquid background */
@keyframes blob-morph {
  0%, 100% { border-radius: 42% 58% 63% 37% / 41% 44% 56% 59%; }
  33%      { border-radius: 62% 38% 41% 59% / 56% 63% 37% 44%; }
  66%      { border-radius: 38% 62% 56% 44% / 63% 41% 59% 37%; }
}

@keyframes blob-drift {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50%      { transform: translate(24px, -28px) scale(1.08); }
}

.blob {
  position: absolute;
  filter: blur(48px);
  opacity: 0.55;
  animation: blob-morph 14s ease-in-out infinite, blob-drift 18s ease-in-out infinite;
  will-change: transform, border-radius;
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .liquid-glass-blue::before { animation: none; }
  .blob { animation: none; }
}

/* ── Claymorphism (card / button primitives) ──────────────────────────────── */

/* Page wrapper: dark navy background — consistent across all non-home views */
.clay-page {
  background: #0A0D18;
}

/* White lifted card — used for profile sections, saved pizzas, order cards */
.clay {
  background: #ffffff;
  border-radius: 24px;
  box-shadow:
    0 4px 24px rgba(0, 0, 0, 0.18),
    0 1px 4px rgba(0, 0, 0, 0.08);
}

.clay-soft {
  background: #ffffff;
  border-radius: 18px;
  box-shadow:
    0 2px 12px rgba(0, 0, 0, 0.12),
    0 1px 3px rgba(0, 0, 0, 0.06);
}

/* Inset surface — inputs, tags on white cards */
.clay-inset {
  background: #f1f5f9;
  border-radius: 12px;
  border: 1px solid #e2e8f0;
}

/* Neutral raised button */
.clay-btn {
  border-radius: 14px;
  box-shadow:
    0 2px 8px rgba(0, 0, 0, 0.12),
    0 1px 2px rgba(0, 0, 0, 0.06);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.clay-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 14px rgba(0,0,0,0.16); }
.clay-btn:active { transform: translateY(1px); box-shadow: 0 1px 4px rgba(0,0,0,0.1); }

/* Primary red CTA — home & global accent buttons */
.clay-accent {
  background: linear-gradient(135deg, #ef4444, #dc2626);
  border-radius: 14px;
  box-shadow: 0 4px 16px rgba(220, 38, 38, 0.35);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.clay-accent:hover { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(220, 38, 38, 0.45); }
.clay-accent:active { transform: translateY(1px); }

/* Gentle floating for background characters */
@keyframes minion-float {
  0%, 100% { transform: translateY(0) rotate(var(--rot, 0deg)); }
  50%      { transform: translateY(-16px) rotate(var(--rot, 0deg)); }
}
.minion-float { animation: minion-float var(--dur, 7s) ease-in-out infinite; }

@media (prefers-reduced-motion: reduce) {
  .minion-float { animation: none; }
}

/* ── Profile light-theme island ───────────────────────────────────────────────
   The profile view sits on a white background. Any stone/light text inside
   .profile-light already uses explicit Tailwind colours so no overrides needed. */

/* Hero text sitting on the background video — white + legible shadow.
   Uses dedicated classes so the light-theme safety net above never recolors it. */
.hero-on-video { color: #ffffff !important; text-shadow: 0 2px 22px rgba(0,0,0,0.55), 0 1px 4px rgba(0,0,0,0.5); }
.hero-sub-on-video { color: rgba(255,255,255,0.94) !important; text-shadow: 0 1px 12px rgba(0,0,0,0.55); }
